using Gtk 4.0;
using Adw 1;

template $LiaFolderPane: Widget {
  Stack content_stack {
    vexpand: true;
    hexpand: true;
    transition-type: crossfade;
    transition-duration: 150;

    styles [
      "file-view",
    ]

    StackPage {
      name: "view";

      child: $LiaFileView file_view {};
    }

    StackPage {
      name: "loading";

      child: Adw.Spinner {
        halign: center;
        valign: center;
        width-request: 32;
        height-request: 32;
      };
    }

    StackPage {
      name: "status";

      child: Adw.StatusPage status_page {
        styles [
          "compact",
        ]
      };
    }
  }
}
