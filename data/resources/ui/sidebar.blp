using Gtk 4.0;

template $LiaSidebar: Widget {
  ScrolledWindow {
    hscrollbar-policy: never;
    propagate-natural-height: true;

    ListBox list_box {
      selection-mode: single;

      styles [
        "navigation-sidebar",
      ]

      accessibility {
        label: _("Places");
      }
    }
  }
}

menu row_menu {
  section {
    item {
      label: _("Open in New _Tab");
      action: "sidebar.open-in-new-tab";
      hidden-when: "action-disabled";
    }
  }

  section {
    item {
      label: _("_Unpin");
      action: "sidebar.unpin";
      hidden-when: "action-disabled";
    }

    item {
      label: _("_Empty Trash");
      action: "sidebar.empty-trash";
      hidden-when: "action-disabled";
    }

    item {
      label: _("_Mount");
      action: "sidebar.mount";
      hidden-when: "action-disabled";
    }

    item {
      label: _("U_nmount");
      action: "sidebar.unmount";
      hidden-when: "action-disabled";
    }

    item {
      label: _("_Eject");
      action: "sidebar.eject";
      hidden-when: "action-disabled";
    }
  }

  section {
    item {
      label: _("P_roperties");
      action: "sidebar.properties";
      hidden-when: "action-disabled";
    }
  }
}
