<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="lia-files">
  <enum id="io.github.lia.Files.ViewMode">
    <value nick="details" value="0"/>
    <value nick="grid" value="1"/>
  </enum>

  <enum id="io.github.lia.Files.ThumbnailPolicy">
    <value nick="always" value="0"/>
    <value nick="local-only" value="1"/>
    <value nick="never" value="2"/>
  </enum>

  <enum id="io.github.lia.Files.ColorScheme">
    <value nick="system" value="0"/>
    <value nick="light" value="1"/>
    <value nick="dark" value="2"/>
  </enum>

  <enum id="io.github.lia.Files.StartLocation">
    <value nick="home" value="0"/>
    <value nick="recent" value="1"/>
  </enum>

  <enum id="io.github.lia.Files.ArchiveFormat">
    <value nick="zip" value="0"/>
    <value nick="tar-gz" value="1"/>
    <value nick="tar-xz" value="2"/>
    <value nick="7z" value="3"/>
  </enum>

  <schema id="io.github.lia.Files" path="/io/github/lia/Files/">
    <!-- Appearance & behaviour -->
    <key name="color-scheme" enum="io.github.lia.Files.ColorScheme">
      <default>'system'</default>
      <summary>Light or dark style</summary>
      <description>“system” follows the desktop's preference.</description>
    </key>
    <key name="single-click" type="b">
      <default>false</default>
      <summary>Open items with a single click</summary>
    </key>
    <key name="confirm-trash" type="b">
      <default>false</default>
      <summary>Ask before moving items to the Trash</summary>
    </key>

    <!-- Window state -->
    <key name="window-width" type="i">
      <default>1200</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>760</default>
      <summary>Window height</summary>
    </key>
    <key name="is-maximized" type="b">
      <default>false</default>
      <summary>Whether the window is maximized</summary>
    </key>
    <key name="sidebar-width" type="i">
      <range min="180" max="360"/>
      <default>220</default>
      <summary>Width of the navigation pane</summary>
    </key>

    <!-- Session -->
    <key name="start-location" enum="io.github.lia.Files.StartLocation">
      <default>'home'</default>
      <summary>Folder opened in new windows at startup</summary>
      <description>Used when the last session isn't restored.</description>
    </key>
    <key name="restore-session" type="b">
      <default>true</default>
      <summary>Reopen the tabs of the last session on startup</summary>
    </key>
    <key name="session-tabs" type="as">
      <default>[]</default>
      <summary>URIs of the tabs open when the last window was closed</summary>
    </key>
    <key name="session-active-tab" type="i">
      <default>0</default>
      <summary>Index of the selected tab in session-tabs</summary>
    </key>

    <!-- Views -->
    <key name="default-view" enum="io.github.lia.Files.ViewMode">
      <default>'details'</default>
      <summary>Default view mode</summary>
      <description>Used for folders whose view hasn't been changed; changes made in a folder are remembered for it.</description>
    </key>
    <key name="icon-size" type="i">
      <range min="32" max="256"/>
      <default>96</default>
      <summary>Icon size in grid view, in pixels</summary>
    </key>
    <key name="show-hidden" type="b">
      <default>false</default>
      <summary>Show hidden files</summary>
    </key>
    <key name="sort-folders-first" type="b">
      <default>true</default>
      <summary>List folders before files</summary>
    </key>

    <!-- Thumbnails & details pane -->
    <key name="thumbnail-policy" enum="io.github.lia.Files.ThumbnailPolicy">
      <default>'local-only'</default>
      <summary>Which files get thumbnails</summary>
      <description>Thumbnails already in the shared cache are always used; this decides which files new thumbnails are made for.</description>
    </key>
    <key name="thumbnail-max-size" type="u">
      <default>256</default>
      <summary>Largest file to make a thumbnail for, in megabytes</summary>
    </key>
    <key name="show-details-pane" type="b">
      <default>false</default>
      <summary>Show the details pane</summary>
    </key>
    <key name="details-pane-width" type="i">
      <range min="220" max="480"/>
      <default>300</default>
      <summary>Width of the details pane</summary>
    </key>

    <!-- File operations -->
    <key name="jobs-per-device" type="i">
      <range min="1" max="8"/>
      <default>1</default>
      <summary>File operations run at the same time on one device</summary>
      <description>Copies and moves to the same drive run one after another by default, which is fastest on most disks. Operations on different drives always run in parallel.</description>
    </key>

    <key name="compress-format" enum="io.github.lia.Files.ArchiveFormat">
      <default>'zip'</default>
      <summary>Format of new archives</summary>
      <description>The format last chosen in the Compress dialog.</description>
    </key>

    <!-- Network -->
    <key name="recent-servers" type="as">
      <default>[]</default>
      <summary>Servers recently connected to, most recent first</summary>
    </key>
  </schema>
</schemalist>
